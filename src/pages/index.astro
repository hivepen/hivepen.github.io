---
import { css } from "../../styled-system/css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<!-- NAV -->
<nav
  class={css({
    position: "sticky",
    top: 0,
    zIndex: 100,
    background: "#fafafa",
    borderBottom: "1px solid #ebebeb",
    px: "24px",
    height: "52px",
    display: "flex",
    alignItems: "center",
    justifyContent: "space-between"
  })}
>
  <a 
    class={css({
      fontFamily: "'DM Serif Display', serif",
      fontSize: "18px",
      color: "#0d0d0d",
      letterSpacing: "-0.01em",
      textDecoration: "none"
    })}
    href="#"
  >
    Hivepen
  </a>
  <ul
    class={css({
      display: "flex",
      gap: "24px",
      listStyle: "none",
      m: 0,
      p: 0
    })}
  >
    <li><a 
      class={css({
        fontSize: "11px",
        letterSpacing: "0.12em",
        textTransform: "uppercase",
        color: "#999",
        textDecoration: "none",
        transition: "color 0.2s",
        "&:hover": { color: "#0d0d0d" }
      })}
      href="#projects"
    >
      Projects
    </a></li>
    <li><a 
      class={css({
        fontSize: "11px",
        letterSpacing: "0.12em",
        textTransform: "uppercase",
        color: "#999",
        textDecoration: "none",
        transition: "color 0.2s",
        "&:hover": { color: "#0d0d0d" }
      })}
      href="https://hive.blog" 
      target="_blank"
    >
      Hive
    </a></li>
  </ul>
</nav>

<!-- HERO -->
<section
  class={css({
    padding: "72px 24px 64px",
    maxW: "680px",
    mx: "auto",
    borderBottom: "1.5px solid #0d0d0d"
  })}
>
  <div
    class={css({
      fontSize: "10px",
      letterSpacing: "0.22em",
      textTransform: "uppercase",
      color: "#999",
      marginBottom: "20px",
      opacity: 0,
      animation: "fadeUp 0.7s ease forwards",
      animationDelay: "0.1s"
    })}
  >
    Independent apps · Built with intention
  </div>
  <h1
    class={css({
      fontFamily: "'DM Serif Display', serif",
      fontSize: "clamp(48px, 11vw, 76px)",
      lineHeight: "0.95",
      color: "#0d0d0d",
      letterSpacing: "-0.02em",
      marginBottom: "28px",
      m: 0,
      opacity: 0,
      animation: "fadeUp 0.7s ease forwards",
      animationDelay: "0.25s"
    })}
  >
    Tools<br/>
    worth<br/>
    <em
      class={css({
        fontStyle: "italic",
        color: "#555"
      })}
    >
      your time.
    </em>
  </h1>
  <p
    class={css({
      fontSize: "13px",
      color: "#555",
      lineHeight: "1.75",
      maxW: "380px",
      marginBottom: "36px",
      m: 0,
      opacity: 0,
      animation: "fadeUp 0.7s ease forwards",
      animationDelay: "0.4s"
    })}
  >
    We build apps that respect your attention. No ads, no dark patterns — just focused experiences designed to last.
  </p>
  <div
    class={css({
      display: "flex",
      gap: "24px",
      alignItems: "center",
      flexWrap: "wrap",
      opacity: 0,
      animation: "fadeUp 0.7s ease forwards",
      animationDelay: "0.55s"
    })}
  >
    <div
      class={css({
        fontSize: "10px",
        letterSpacing: "0.14em",
        textTransform: "uppercase",
        color: "#999"
      })}
    >
      <strong
        class={css({
          fontSize: "22px",
          fontFamily: "'DM Serif Display', serif",
          fontWeight: "normal",
          color: "#0d0d0d",
          display: "block",
          letterSpacing: "-0.02em",
          marginBottom: "2px"
        })}
      >
        3
      </strong>
      Projects
    </div>
    <div
      class={css({
        width: "1px",
        height: "32px",
        background: "#ebebeb"
      })}
    ></div>
    <div
      class={css({
        fontSize: "10px",
        letterSpacing: "0.14em",
        textTransform: "uppercase",
        color: "#999"
      })}
    >
      <strong
        class={css({
          fontSize: "22px",
          fontFamily: "'DM Serif Display', serif",
          fontWeight: "normal",
          color: "#0d0d0d",
          display: "block",
          letterSpacing: "-0.02em",
          marginBottom: "2px"
        })}
      >
        0
      </strong>
      Ads
    </div>
    <div
      class={css({
        width: "1px",
        height: "32px",
        background: "#ebebeb"
      })}
    ></div>
    <div
      class={css({
        fontSize: "10px",
        letterSpacing: "0.14em",
        textTransform: "uppercase",
        color: "#999"
      })}
    >
      <strong
        class={css({
          fontSize: "22px",
          fontFamily: "'DM Serif Display', serif",
          fontWeight: "normal",
          color: "#0d0d0d",
          display: "block",
          letterSpacing: "-0.02em",
          marginBottom: "2px"
        })}
      >
        ∞
      </strong>
      Patience
    </div>
  </div>
</section>

<!-- SECTION LABEL -->
<div
  class={css({
    maxW: "680px",
    mx: "auto",
    padding: "40px 24px 20px",
    display: "flex",
    alignItems: "center",
    gap: "16px",
    opacity: 0,
    animation: "fadeUp 0.7s ease forwards",
    animationDelay: "0.55s"
  })}
>
  <span
    class={css({
      fontSize: "10px",
      letterSpacing: "0.2em",
      textTransform: "uppercase",
      color: "#999"
    })}
  >
    What we're building
  </span>
  <div
    class={css({
      flex: 1,
      height: "1px",
      background: "#ebebeb"
    })}
  ></div>
</div>

<!-- PROJECTS -->
<div
  class={css({
    maxW: "680px",
    mx: "auto",
    padding: "0 24px 80px",
    display: "flex",
    flexDirection: "column",
    gap: "0"
  })}
  id="projects"
>
  {projects.map((project) => <ProjectCard {...project} />)}
</div>

<!-- MANIFESTO -->
<div
  class={css({
    background: "#0d0d0d",
    padding: "52px 24px",
    textAlign: "center"
  })}
>
  <div
    class={css({
      maxW: "520px",
      mx: "auto"
    })}
  >
    <div
      class={css({
        fontFamily: "'DM Serif Display', serif",
        fontSize: "clamp(22px, 5vw, 32px)",
        color: "#fff",
        lineHeight: "1.35",
        marginBottom: "24px",
        opacity: 0,
        animation: "fadeUp 0.7s ease forwards",
        animationDelay: "0.1s"
      })}
    >
      "We believe the best products<br/>earn your return — <em
        class={css({
          fontStyle: "italic",
          color: "#888"
        })}
      >
        not demand it.
      </em>"
    </div>
    <div
      class={css({
        width: "32px",
        height: "1.5px",
        background: "#444",
        mx: "auto",
        marginBottom: "18px"
      })}
    ></div>
    <div
      class={css({
        fontSize: "10px",
        letterSpacing: "0.2em",
        textTransform: "uppercase",
        color: "#555"
      })}
    >
      Hivepen · hivepen.com
    </div>
  </div>
</div>

<Footer />

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 480px) {
    nav { padding: 0 16px; }
    .nav-links { gap: 16px; }
    .hero { padding: 48px 16px 48px; }
    .section-label { padding: 32px 16px 16px; }
    .projects { padding: 0 16px 60px; }
    .card-inner { padding: 22px 20px 20px; }
    .card-name { font-size: 32px; }
    footer { padding: 28px 16px; }
    .manifesto { padding: 44px 16px; }
  }
</style>

</BaseLayout>
